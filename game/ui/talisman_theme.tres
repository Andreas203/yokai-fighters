[gd_resource type="Theme" load_steps=14 format=3]

[ext_resource type="StyleBox" path="res://ui/kit/paper_sheet_style.tres" id="k_sheet"]
[ext_resource type="StyleBox" path="res://ui/kit/paper_card_style.tres" id="k_card"]

; Fonts. No font files are in the project, so the kit asks the OS for a bold serif (first match wins) and the
; engine default stays the fallback. OPEN DECISION: ship a licensed serif + brush font so every machine looks the same.
[sub_resource type="SystemFont" id="font_serif"]
font_names = PackedStringArray("Georgia", "Palatino", "Noto Serif", "DejaVu Serif", "Times New Roman", "serif")
font_weight = 700
antialiasing = 1
subpixel_positioning = 1

; Brush-style heading stand-in: the same serif, emboldened and slanted. Replace with a brush font when one is approved.
[sub_resource type="FontVariation" id="font_heading"]
base_font = SubResource("font_serif")
variation_embolden = 0.2
variation_transform = Transform2D(1, 0, 0.12, 1, 0, 0)


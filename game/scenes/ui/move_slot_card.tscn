[gd_scene format=3]
[ext_resource type="Theme" path="res://ui/talisman_theme.tres" id="theme"]
[ext_resource type="PackedScene" path="res://scenes/ui/kit/kit_backdrop.tscn" id="back"]
[ext_resource type="PackedScene" path="res://scenes/ui/kit/menu_row.tscn" id="row"]
[ext_resource type="PackedScene" path="res://scenes/ui/kit/ghost_button.tscn" id="ghost"]
[ext_resource type="PackedScene" path="res://scenes/ui/kit/key_chip_footer.tscn" id="footer"]
[ext_resource type="PackedScene" path="res://scenes/ui/kit/corner_ornament.tscn" id="corner"]
[ext_resource type="PackedScene" path="res://scenes/ui/kit/paper_dialog.tscn" id="dialog"]
[ext_resource type="Texture2D" path="res://assets/generated/ui/ink-underline.png" id="line"]
[ext_resource type="Texture2D" path="res://assets/generated/ui/fox-mask.png" id="mask"]



[ext_resource type="Texture2D" path="res://assets/generated/ui/rice-card.png" id="card_tex"]
[ext_resource type="Script" path="res://scripts/Ui/Menus/MoveSlotCard.cs" id="r1"]
[ext_resource type="Script" path="res://scripts/Ui/SealStamp.cs" id="r2"]
[ext_resource type="Script" path="res://scripts/Ui/Menus/LevelPips.cs" id="r3"]

[sub_resource type="StyleBoxTexture" id="card_style"]
texture = ExtResource("card_tex")
content_margin_left = 44.0
texture_margin_left = 28.0
content_margin_top = 36.0
texture_margin_top = 28.0
content_margin_right = 44.0
texture_margin_right = 28.0
content_margin_bottom = 44.0
texture_margin_bottom = 28.0

[node name="MoveSlotCard" type="PanelContainer"]
theme = ExtResource("theme")
theme_type_variation = &"PaperCard"
theme_override_styles/panel = SubResource("card_style")
script = ExtResource("r1")
custom_minimum_size = Vector2(530, 0)
size_flags_horizontal = 3

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Top" type="HBoxContainer" parent="Box"]
layout_mode = 2

[node name="Crest" type="Control" parent="Box/Top"]
script = ExtResource("r2")
custom_minimum_size = Vector2(48, 48)
mouse_filter = 2

[node name="Icon" type="TextureRect" parent="Box/Top"]
custom_minimum_size = Vector2(56, 56)
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Name" type="Label" parent="Box/Top"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3
theme_override_font_sizes/font_size = 30

[node name="Pips" type="Control" parent="Box"]
script = ExtResource("r3")
custom_minimum_size = Vector2(120, 24)
mouse_filter = 2

[node name="Input" type="Label" parent="Box"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3
theme_override_font_sizes/font_size = 26

[node name="Plain" type="Label" parent="Box"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3
theme_override_font_sizes/font_size = 26

[node name="Frames" type="Label" parent="Box"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3
theme_override_font_sizes/font_size = 26

[node name="Mod" type="Label" parent="Box"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3
theme_override_font_sizes/font_size = 26

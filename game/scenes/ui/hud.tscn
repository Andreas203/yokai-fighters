[ext_resource type="Texture2D" path="res://assets/generated/ui/burst-blank.png" id="burst"]

[sub_resource type="StyleBoxEmpty" id="empty"]

[sub_resource type="Shader" id="seal_shader"]
code = "shader_type canvas_item;
uniform bool spent = false;
void fragment() {
 vec4 ink = texture(TEXTURE, UV);
 if (spent) {
  ink.rgb = vec3(dot(ink.rgb, vec3(0.299, 0.587, 0.114))) * 0.7;
  ink.a *= 0.7;
 }
 COLOR = ink;
}"

[sub_resource type="ShaderMaterial" id="seal_material"]
resource_local_to_scene = true
shader = SubResource("seal_shader")


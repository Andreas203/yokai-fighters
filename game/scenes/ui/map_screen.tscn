[ext_resource type="PackedScene" path="res://scenes/ui/copy_chip.tscn" id="chip"]
[ext_resource type="Resource" path="res://ui/map_node_styles.tres" id="styles"]

[sub_resource type="StyleBoxFlat" id="paper_panel"]
bg_color = Color(0.945, 0.91, 0.831, 1)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4

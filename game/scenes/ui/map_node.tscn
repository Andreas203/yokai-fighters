[gd_scene format=3]
[ext_resource type="Theme" path="res://ui/talisman_theme.tres" id="theme"]
[ext_resource type="Script" path="res://scripts/Ui/MapNode.cs" id="script"]
[ext_resource type="Script" path="res://scripts/Ui/MapTag.cs" id="tag"]
[ext_resource type="Script" path="res://scripts/Ui/MapTickMark.cs" id="tick"]

[node name="MapNode" type="Button"]
custom_minimum_size = Vector2(190, 200)
offset_right = 190.0
offset_bottom = 200.0
theme = ExtResource("theme")
focus_mode = 0

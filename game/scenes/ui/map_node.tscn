[node name="IconTexture" type="TextureRect" parent="."]
mouse_filter = 2
offset_right = 120.0
offset_bottom = 150.0
expand_mode = 1
stretch_mode = 5

[node name="IconLabel" type="Label" parent="."]
visible = false
mouse_filter = 2
offset_right = 120.0
offset_bottom = 150.0
text = "?"
theme_type_variation = &"BodyLabel"

[node name="ElderMark" type="PanelContainer" parent="."]
visible = false

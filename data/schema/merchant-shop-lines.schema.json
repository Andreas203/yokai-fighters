{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yokai-fighters.local/schema/merchant-shop-lines.schema.json",
  "title": "Merchant shop lines",
  "description": "The merchant's speech-bubble lines in the shop (YOK-159; S1, S2, R6, A12): one file, data/story/shop/merchant-shop-lines.json. Every bubble is at most two sentences (S2). Event lines are picked from 'variants'; the focused-item line joins a 'lead_ins' fragment to the item's plain card text, which is inserted verbatim (A12: frame data is never spoken). Placeholders: {name} and {card_text}, only in item_focused.",
  "type": "object",
  "required": ["kind", "id", "status", "speaker", "rules", "events"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "merchant_shop_lines" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "status": { "$ref": "common.schema.json#/$defs/status" },
    "speaker": { "type": "string", "minLength": 1 },
    "rules": { "$ref": "common.schema.json#/$defs/ruleIds" },
    "notes": { "$ref": "common.schema.json#/$defs/notes" },
    "events": {
      "type": "object",
      "required": ["greeting_row4", "greeting_row7", "item_focused", "bought_special", "bought_modifier", "cannot_afford", "slot_full", "release_binding", "release_last_special", "shelf_empty", "leaving"],
      "additionalProperties": false,
      "properties": {
        "greeting_row4": { "$ref": "#/$defs/plainEvent" },
        "greeting_row7": { "$ref": "#/$defs/plainEvent" },
        "item_focused": {
          "type": "object",
          "required": ["trigger", "placeholders", "lead_ins"],
          "additionalProperties": false,
          "properties": {
            "trigger": { "type": "string", "minLength": 1 },
            "placeholders": { "const": ["name", "card_text"] },
            "lead_ins": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\{name\\}.*\\{card_text\\}" } },
            "notes": { "type": "string" }
          }
        },
        "bought_special": { "$ref": "#/$defs/plainEvent" },
        "bought_modifier": { "$ref": "#/$defs/plainEvent" },
        "cannot_afford": { "$ref": "#/$defs/plainEvent" },
        "slot_full": { "$ref": "#/$defs/plainEvent" },
        "release_binding": { "$ref": "#/$defs/plainEvent" },
        "release_last_special": { "$ref": "#/$defs/plainEvent" },
        "shelf_empty": { "$ref": "#/$defs/plainEvent" },
        "leaving": { "$ref": "#/$defs/plainEvent" }
      }
    }
  },
  "$defs": {
    "plainEvent": {
      "type": "object",
      "required": ["trigger", "placeholders", "variants"],
      "additionalProperties": false,
      "properties": {
        "trigger": { "type": "string", "minLength": 1 },
        "placeholders": { "const": [] },
        "variants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 140, "pattern": "^[^{}]*$" } },
        "notes": { "type": "string" }
      }
    }
  }
}

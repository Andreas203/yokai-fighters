{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yokai-fighters.local/schema/clip.schema.json",
  "title": "Clip match",
  "description": "One animation clip chosen by Clip Matcher (data/clips/<id>.json). Frame data must match it (F2). Frames are 60-tick game frames, 1-based.",
  "type": "object",
  "required": ["kind", "id", "pack", "clip", "frames_total", "hit_start", "hit_end", "retarget_notes"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "clip" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "status": { "$ref": "common.schema.json#/$defs/status" },
    "pack": { "type": "string", "minLength": 1, "description": "Asset pack name from assets/shortlists/." },
    "clip": { "type": "string", "minLength": 1, "description": "Clip name inside the pack." },
    "frames_total": { "type": "integer", "minimum": 1 },
    "hit_start": { "type": ["integer", "null"], "minimum": 1, "description": "First frame the clip visibly hits or releases a projectile; null for clips that never hit (e.g. a teleport)." },
    "hit_end": { "type": ["integer", "null"], "minimum": 1 },
    "retarget_notes": { "type": "string", "description": "Retarget result per yokai (G4), e.g. tail/shell/club clipping." },
    "rules": { "$ref": "common.schema.json#/$defs/ruleIds" },
    "notes": { "$ref": "common.schema.json#/$defs/notes" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yokai-fighters.local/schema/common.schema.json",
  "title": "Shared definitions",
  "description": "Building blocks shared by every content schema. All gameplay numbers are integers (frames, units, percent) so the 60-tick loop stays deterministic (C1, F3).",
  "$defs": {
    "id": {
      "description": "Lowercase kebab-case id; also the file name without .json.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "yokai": {
      "description": "Source of an ability (A8). 'ryo' = Ryo's starters.",
      "enum": ["ryo", "kitsune", "oni", "kappa"]
    },
    "rarity": { "enum": ["common", "rare"] },
    "status": {
      "description": "'proposed' marks values awaiting a designer decision (open questions, untuned first passes).",
      "enum": ["final", "proposed"]
    },
    "ruleIds": {
      "description": "Rule IDs from docs/design/rules.md this content implements or depends on.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[PCKFEXAYTRMSVG][0-9]+$" },
      "uniqueItems": true
    },
    "notes": { "type": "string" },
    "card": {
      "description": "Reward card text (A12): plain language first, frame data behind a toggle.",
      "type": "object",
      "required": ["plain", "frames"],
      "additionalProperties": false,
      "properties": {
        "plain": { "type": "string", "minLength": 1, "maxLength": 140 },
        "frames": { "type": "string", "minLength": 1, "maxLength": 140, "description": "Text shown when the frame-data toggle is on." }
      }
    },
    "frameRange": {
      "description": "Inclusive [first, last] frame, 1-based, counted from the move's first frame.",
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 1 },
        { "type": "integer", "minimum": 1 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "rect": {
      "description": "2D rectangle in gameplay units (1 unit = 1 px at 1920x1080), relative to the character origin at the feet, x toward the opponent, y up (F3, F4).",
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },
    "timedRect": {
      "type": "object",
      "required": ["frames", "rect"],
      "additionalProperties": false,
      "properties": {
        "frames": { "$ref": "#/$defs/frameRange" },
        "rect": { "$ref": "#/$defs/rect" }
      }
    },
    "modifierCondition": {
      "description": "When a modifier's effect applies (YOK-103: exactly what ModifierLoader.Conditions reads). on_hit / on_block: from the move's connect on. first_use_each_round, ryo_health_below_30pct, holding_up: read once, on the tick the special starts.",
      "enum": ["always", "on_hit", "on_block", "first_use_each_round", "ryo_health_below_30pct", "holding_up"]
    },
    "effectTarget": {
      "description": "YOK-103: exactly the targets the C# loader accepts (Effects.Vocabulary). A path into frame data; a first segment that is not a frame-data field resolves under 'properties', so 'projectile.speed' = 'properties.projectile.speed'.",
      "type": "string",
      "pattern": "^(startup|active|recovery|damage|hitstun|blockstun|pushback\\.(on_hit|on_block)|meter_gain\\.(on_hit|on_block)|(properties\\.)?(projectile\\.(speed|hits|absorbs_projectiles|max_active|lifetime)|pull_on_hit|heal_pct_max_health)|pushback|(properties\\.)?(projectile\\.(passes_projectiles|angle_up)|knockdown|launch|counterhit_immune|projectile_interrupt_immune)|(properties\\.)?(armour|throw_invuln))$"
    },
    "effectShape": {
      "description": "YOK-103: the op and value each kind of target takes, as the loader checks them (Effects.Check).",
      "allOf": [
        {
          "if": { "required": ["target"], "properties": { "target": { "pattern": "^(startup|active|recovery|damage|hitstun|blockstun|pushback\\.(on_hit|on_block)|meter_gain\\.(on_hit|on_block)|(properties\\.)?(projectile\\.(speed|hits|absorbs_projectiles|max_active|lifetime)|pull_on_hit|heal_pct_max_health)|ex\\.meter_cost)$" } } },
          "then": { "properties": { "value": { "type": "integer" } } }
        },
        {
          "if": { "required": ["target"], "properties": { "target": { "const": "pushback" } } },
          "then": { "properties": { "op": { "enum": ["add", "mul_pct"] }, "value": { "type": "integer" } } }
        },
        {
          "if": { "required": ["target"], "properties": { "target": { "pattern": "^(properties\\.)?(projectile\\.(passes_projectiles|angle_up)|knockdown|launch|counterhit_immune|projectile_interrupt_immune)$" } } },
          "then": { "properties": { "op": { "const": "set" }, "value": { "type": "boolean" } } }
        },
        {
          "if": { "required": ["target"], "properties": { "target": { "pattern": "^(properties\\.)?armour$" } } },
          "then": {
            "properties": {
              "op": { "const": "set" },
              "value": {
                "type": "object",
                "required": ["frames"],
                "additionalProperties": false,
                "properties": {
                  "frames": { "$ref": "#/$defs/frameRange" },
                  "hits": { "type": "integer", "minimum": 1, "description": "Hits taken per use; omitted = 1." }
                }
              }
            }
          }
        },
        {
          "if": { "required": ["target"], "properties": { "target": { "pattern": "^(properties\\.)?throw_invuln$" } } },
          "then": { "properties": { "op": { "const": "set" }, "value": { "const": "startup" } } }
        }
      ]
    },
    "effect": {
      "description": "One data-only change to a move at a level or in its EX version (A4, A5). Integer values: frames, units, or percent for mul_pct (130 = x1.3, rounded to nearest, E20). Never conditional: 'when' is a modifier's.",
      "type": "object",
      "required": ["target", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/effectTarget" },
        "op": { "enum": ["add", "mul_pct", "set"] },
        "value": { "type": ["integer", "boolean", "object", "string"] },
        "when": { "const": "always" }
      },
      "$ref": "#/$defs/effectShape"
    },
    "modifierEffect": {
      "description": "One data-only change a modifier makes (A10): an effect that may carry a condition, or 'ex.meter_cost' (the special's EX cost, never conditional).",
      "type": "object",
      "required": ["target", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "target": { "anyOf": [{ "$ref": "#/$defs/effectTarget" }, { "const": "ex.meter_cost" }] },
        "op": { "enum": ["add", "mul_pct", "set"] },
        "value": { "type": ["integer", "boolean", "object", "string"] },
        "when": { "$ref": "#/$defs/modifierCondition" }
      },
      "allOf": [
        { "$ref": "#/$defs/effectShape" },
        {
          "if": { "required": ["target"], "properties": { "target": { "const": "ex.meter_cost" } } },
          "then": { "properties": { "when": { "const": "always" } } }
        }
      ]
    }
  }
}
